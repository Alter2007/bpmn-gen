{
  "templateId": "budget_adjust",
  "name": "预算调整",
  "description": "预算变更：财务审核后再由分管领导审批",
  "keywords": [
    "预算调整",
    "调预算",
    "预算变更",
    "追加预算"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "budgetAdjust",
  "processName": "预算调整",
  "variables": [
    {
      "name": "delta",
      "type": "number",
      "description": "调整金额"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起预算调整"
    },
    {
      "id": "Task_Apply",
      "type": "userTask",
      "name": "提交预算调整",
      "assignee": "${initiator}"
    },
    {
      "id": "Task_Finance",
      "type": "userTask",
      "name": "财务审核",
      "assignee": "${finance}"
    },
    {
      "id": "Task_Leader",
      "type": "userTask",
      "name": "分管领导审批",
      "assignee": "${director}"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Apply"
    },
    {
      "id": "Flow_2",
      "from": "Task_Apply",
      "to": "Task_Finance"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Finance",
      "to": "Task_Leader",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Leader",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_9_R1",
      "from": "Task_Finance",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_9_R2",
      "from": "Task_Leader",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') == false}"
    }
  ]
}
