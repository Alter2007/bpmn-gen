{
  "templateId": "simple_approval",
  "name": "单级审批",
  "description": "提交后由一名审批人处理即可完成，适合最简单的场景；是否需要上级复核时需上级复核",
  "keywords": [
    "单级",
    "简单",
    "简易",
    "一个人批",
    "直接通过",
    "无需多级",
    "一人审批",
    "单人审批",
    "一级审批",
    "直接批"
  ],
  "slotOrder": [],
  "slots": [
    {
      "name": "subject",
      "type": "string",
      "default": "申请",
      "label": "业务对象"
    },
    {
      "name": "approver",
      "type": "string",
      "default": "${manager}",
      "label": "审批人"
    }
  ],
  "processId": "simpleApproval",
  "processName": "@subject@审批流",
  "variables": [
    {
      "name": "needReview",
      "type": "boolean",
      "description": "是否需要上级复核"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起@subject@"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交@subject@",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_NeedReview",
      "type": "exclusiveGateway",
      "name": "是否需要上级复核"
    },
    {
      "id": "Task_NeedReview",
      "type": "userTask",
      "name": "上级复核",
      "assignee": "${director}"
    },
    {
      "id": "Task_Approve",
      "type": "userTask",
      "name": "审批",
      "assignee": "@approver@"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "完成"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_NeedReview"
    },
    {
      "id": "Flow_3",
      "from": "Task_Approve",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_NeedReview_Y",
      "from": "Gateway_NeedReview",
      "to": "Task_NeedReview",
      "name": "需要",
      "condition": "${needReview == true}"
    },
    {
      "id": "Flow_NeedReview_N",
      "from": "Gateway_NeedReview",
      "to": "Task_Approve",
      "name": "不需要",
      "default": true
    },
    {
      "id": "Flow_NeedReview_M",
      "from": "Task_NeedReview",
      "to": "Task_Approve",
      "default": true
    },
    {
      "id": "Flow_NeedReview_R",
      "from": "Task_NeedReview",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R_Task_Approve",
      "from": "Task_Approve",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
