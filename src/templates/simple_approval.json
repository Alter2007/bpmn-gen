{
  "templateId": "simple_approval",
  "name": "单级审批",
  "description": "提交后由一名审批人处理即可完成，适合最简单的场景",
  "keywords": ["单级", "简单", "简易", "一个人批", "直接通过", "无需多级"],
  "slotOrder": [],
  "slots": [
    { "name": "subject", "type": "string", "default": "申请", "label": "业务对象" },
    { "name": "approver", "type": "string", "default": "${manager}", "label": "审批人" }
  ],
  "processId": "simpleApproval",
  "processName": "@subject@审批流",
  "variables": [],
  "nodes": [
    { "id": "StartEvent_1", "type": "startEvent", "name": "发起@subject@" },
    { "id": "Task_Submit", "type": "userTask", "name": "提交@subject@", "assignee": "${initiator}" },
    { "id": "Task_Approve", "type": "userTask", "name": "审批", "assignee": "@approver@" },
    { "id": "EndEvent_1", "type": "endEvent", "name": "完成" }
  ],
  "flows": [
    { "id": "Flow_1", "from": "StartEvent_1", "to": "Task_Submit" },
    { "id": "Flow_2", "from": "Task_Submit", "to": "Task_Approve" },
    { "id": "Flow_3", "from": "Task_Approve", "to": "EndEvent_1" }
  ]
}
