{
  "templateId": "amount_tiered",
  "name": "金额分级审批",
  "description": "按金额区间分级审批：小额一级审批，中额升级审批，大额财务复核",
  "keywords": [
    "报销",
    "差旅",
    "金额",
    "费用",
    "分级",
    "标准",
    "超过",
    "小于",
    "大于"
  ],
  "slotOrder": [
    "tier1",
    "tier2"
  ],
  "slots": [
    {
      "name": "subject",
      "type": "string",
      "default": "报销",
      "label": "业务对象"
    },
    {
      "name": "varName",
      "type": "string",
      "default": "amount",
      "label": "金额变量名"
    },
    {
      "name": "tier1",
      "type": "number",
      "default": 1000,
      "label": "第一档上限"
    },
    {
      "name": "tier2",
      "type": "number",
      "default": 5000,
      "label": "第二档上限"
    }
  ],
  "processId": "amountTiered",
  "processName": "@subject@审批流",
  "variables": [
    {
      "name": "@varName@",
      "type": "number",
      "description": "业务金额"
    },
    {
      "name": "costType",
      "type": "enum",
      "required": true,
      "description": "费用类型",
      "options": [
        {
          "value": "traffic",
          "label": "交通"
        },
        {
          "value": "hotel",
          "label": "住宿"
        },
        {
          "value": "meal",
          "label": "餐饮"
        },
        {
          "value": "other",
          "label": "其他"
        }
      ]
    },
    {
      "name": "invoiceNo",
      "type": "string",
      "required": false,
      "description": "发票号"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起@subject@"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交@subject@单",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_1",
      "type": "exclusiveGateway",
      "name": "@subject@金额判断"
    },
    {
      "id": "Task_Level1",
      "type": "userTask",
      "name": "主管审批",
      "candidateGroups": "role_manager"
    },
    {
      "id": "Task_Level2",
      "type": "userTask",
      "name": "总监审批",
      "candidateGroups": "role_director"
    },
    {
      "id": "Task_Finance",
      "type": "userTask",
      "name": "财务复核",
      "candidateGroups": "role_finance"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "审批完成"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_1"
    },
    {
      "id": "Flow_3",
      "from": "Gateway_1",
      "to": "Task_Level1",
      "name": "≤@tier1@",
      "condition": "${@varName@ <= @tier1@}"
    },
    {
      "id": "Flow_4",
      "from": "Gateway_1",
      "to": "Task_Level2",
      "name": "@tier1@~@tier2@",
      "condition": "${@varName@ > @tier1@ && @varName@ <= @tier2@}"
    },
    {
      "id": "Flow_5",
      "from": "Gateway_1",
      "to": "Task_Finance",
      "name": ">@tier2@",
      "default": true
    },
    {
      "id": "Flow_6",
      "from": "Task_Level1",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_7",
      "from": "Task_Level2",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_8",
      "from": "Task_Finance",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_9",
      "from": "Task_Level1",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_10",
      "from": "Task_Level2",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_11",
      "from": "Task_Finance",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
