{
  "templateId": "contract_review",
  "name": "合同并行会签",
  "description": "法务、财务、业务三方并行会签，全部完成后汇总",
  "keywords": [
    "合同",
    "会签",
    "法务",
    "律师",
    "评审",
    "条款",
    "签署"
  ],
  "slotOrder": [],
  "slots": [
    {
      "name": "subject",
      "type": "string",
      "default": "合同",
      "label": "业务对象"
    }
  ],
  "processId": "contractReview",
  "processName": "@subject@会签流程",
  "variables": [
    {
      "name": "contractNo",
      "type": "string",
      "required": true,
      "description": "合同编号"
    },
    {
      "name": "contractAmount",
      "type": "number",
      "required": true,
      "description": "合同金额（元）"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起@subject@评审"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交@subject@",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_Split",
      "type": "parallelGateway",
      "name": "并行会签"
    },
    {
      "id": "Task_Legal",
      "type": "userTask",
      "name": "法务审核",
      "candidateGroups": "role_legal"
    },
    {
      "id": "Task_Finance",
      "type": "userTask",
      "name": "财务审核",
      "candidateGroups": "role_finance"
    },
    {
      "id": "Task_Business",
      "type": "userTask",
      "name": "业务审核",
      "candidateGroups": "role_business"
    },
    {
      "id": "Gateway_Join",
      "type": "parallelGateway",
      "name": "会签汇总"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "评审完成"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_Split"
    },
    {
      "id": "Flow_3",
      "from": "Gateway_Split",
      "to": "Task_Legal"
    },
    {
      "id": "Flow_4",
      "from": "Gateway_Split",
      "to": "Task_Finance"
    },
    {
      "id": "Flow_5",
      "from": "Gateway_Split",
      "to": "Task_Business"
    },
    {
      "id": "Flow_6",
      "from": "Task_Legal",
      "to": "Gateway_Join",
      "default": true
    },
    {
      "id": "Flow_7",
      "from": "Task_Finance",
      "to": "Gateway_Join",
      "default": true
    },
    {
      "id": "Flow_8",
      "from": "Task_Business",
      "to": "Gateway_Join",
      "default": true
    },
    {
      "id": "Flow_9",
      "from": "Gateway_Join",
      "to": "EndEvent_1"
    },
    {
      "id": "Flow_R_Task_Legal",
      "from": "Task_Legal",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R_Task_Finance",
      "from": "Task_Finance",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R_Task_Business",
      "from": "Task_Business",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
