{
  "templateId": "expense_reimburse",
  "name": "费用报销串行审批",
  "description": "提交后依次经过部门审核与财务审核，适合标准报销场景",
  "keywords": ["报销", "费用", "发票", "垫付", "部门", "财务", "审核", "归档"],
  "slotOrder": [],
  "slots": [
    { "name": "subject", "type": "string", "default": "费用报销", "label": "业务对象" }
  ],
  "processId": "expenseReimburse",
  "processName": "@subject@流程",
  "variables": [],
  "nodes": [
    { "id": "StartEvent_1", "type": "startEvent", "name": "发起@subject@" },
    { "id": "Task_Submit", "type": "userTask", "name": "提交报销单", "assignee": "${initiator}" },
    { "id": "Task_Dept", "type": "userTask", "name": "部门审核", "assignee": "${deptManager}" },
    { "id": "Task_Finance", "type": "userTask", "name": "财务审核", "assignee": "${finance}" },
    { "id": "Task_Archive", "type": "userTask", "name": "归档入账", "assignee": "${finance}" },
    { "id": "EndEvent_1", "type": "endEvent", "name": "完成" }
  ],
  "flows": [
    { "id": "Flow_1", "from": "StartEvent_1", "to": "Task_Submit" },
    { "id": "Flow_2", "from": "Task_Submit", "to": "Task_Dept" },
    { "id": "Flow_3", "from": "Task_Dept", "to": "Task_Finance" },
    { "id": "Flow_4", "from": "Task_Finance", "to": "Task_Archive" },
    { "id": "Flow_5", "from": "Task_Archive", "to": "EndEvent_1" }
  ]
}
