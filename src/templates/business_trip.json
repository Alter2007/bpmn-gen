{
  "templateId": "business_trip",
  "name": "出差申请",
  "description": "出差申报：主管审批后由行政备案行程",
  "keywords": [
    "出差",
    "行程",
    "外出",
    "差旅安排"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "businessTrip",
  "processName": "出差申请",
  "variables": [
    {
      "name": "days",
      "type": "number",
      "description": "出差天数"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起出差申请"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交出差申请",
      "assignee": "${initiator}"
    },
    {
      "id": "Task_Leader",
      "type": "userTask",
      "name": "直属主管审批",
      "assignee": "${manager}"
    },
    {
      "id": "Task_Admin",
      "type": "userTask",
      "name": "行政备案",
      "assignee": "${admin}"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Task_Leader"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Leader",
      "to": "Task_Admin",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Admin",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_R1",
      "from": "Task_Leader",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R2",
      "from": "Task_Admin",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') == false}"
    }
  ]
}
