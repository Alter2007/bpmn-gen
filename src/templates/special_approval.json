{
  "templateId": "special_approval",
  "name": "特殊事项审批",
  "description": "特事特批：逐级上报至分管领导与主要领导",
  "keywords": [
    "特殊事项",
    "特批",
    "越级",
    "例外审批",
    "特事特办"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "specialApproval",
  "processName": "特殊事项审批",
  "variables": [
    {
      "name": "reason",
      "type": "string",
      "description": "特殊事由"
    },
    {
      "name": "reportUp",
      "type": "boolean",
      "description": "是否需要上报上级机关"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起特殊事项审批"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交申请",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_ReportUp",
      "type": "exclusiveGateway",
      "name": "是否需要上报"
    },
    {
      "id": "Task_ReportUp",
      "type": "userTask",
      "name": "上报审核",
      "assignee": "${leader}"
    },
    {
      "id": "Task_Director",
      "type": "userTask",
      "name": "分管领导审批",
      "assignee": "${director}"
    },
    {
      "id": "Task_Gm",
      "type": "userTask",
      "name": "主要领导批准",
      "assignee": "${gm}"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_ReportUp"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Director",
      "to": "Task_Gm",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Gm",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_R1",
      "from": "Task_Director",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R2",
      "from": "Task_Gm",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_ReportUp_Y",
      "from": "Gateway_ReportUp",
      "to": "Task_ReportUp",
      "name": "需上报",
      "condition": "${reportUp == true}"
    },
    {
      "id": "Flow_ReportUp_N",
      "from": "Gateway_ReportUp",
      "to": "Task_Director",
      "name": "所内处理",
      "default": true
    },
    {
      "id": "Flow_ReportUp_M",
      "from": "Task_ReportUp",
      "to": "Task_Director",
      "default": true
    },
    {
      "id": "Flow_ReportUp_R",
      "from": "Task_ReportUp",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
