{
  "templateId": "supplier_onboard",
  "name": "供应商准入",
  "description": "新供应商入库：资质审核、采购审批、财务备案",
  "keywords": [
    "供应商",
    "准入",
    "资质",
    "供应商审核",
    "入库供应商"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "supplierOnboard",
  "processName": "供应商准入",
  "variables": [
    {
      "name": "credit",
      "type": "string",
      "description": "供应商信用代码"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起供应商准入"
    },
    {
      "id": "Task_Apply",
      "type": "userTask",
      "name": "提交供应商资料",
      "assignee": "${initiator}"
    },
    {
      "id": "Task_Qualify",
      "type": "userTask",
      "name": "资质审核",
      "assignee": "${qualify}"
    },
    {
      "id": "Task_Purchase",
      "type": "userTask",
      "name": "采购部审批",
      "assignee": "${purchase}"
    },
    {
      "id": "Task_Finance",
      "type": "userTask",
      "name": "财务备案",
      "assignee": "${finance}"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Apply"
    },
    {
      "id": "Flow_2",
      "from": "Task_Apply",
      "to": "Task_Qualify"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Qualify",
      "to": "Task_Purchase",
      "default": true
    },
    {
      "id": "Flow_A2",
      "from": "Task_Purchase",
      "to": "Task_Finance",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Finance",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_9_R1",
      "from": "Task_Qualify",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_9_R2",
      "from": "Task_Purchase",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_9_R3",
      "from": "Task_Finance",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
