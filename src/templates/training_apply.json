{
  "templateId": "training_apply",
  "name": "培训申请",
  "description": "外部培训：主管审批后由 HR 审批预算；是否外部培训时需HR 总监审批",
  "keywords": [
    "培训",
    "课程",
    "外部培训",
    "培训费",
    "进修"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "trainingApply",
  "processName": "培训申请",
  "variables": [
    {
      "name": "cost",
      "type": "number",
      "description": "培训费用"
    },
    {
      "name": "external",
      "type": "boolean",
      "description": "是否外部培训（外部培训需 HR 总监审批）"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起培训申请"
    },
    {
      "id": "Task_Apply",
      "type": "userTask",
      "name": "提交培训申请",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_External",
      "type": "exclusiveGateway",
      "name": "是否外部培训"
    },
    {
      "id": "Task_External",
      "type": "userTask",
      "name": "HR 总监审批",
      "assignee": "${hr}"
    },
    {
      "id": "Task_Leader",
      "type": "userTask",
      "name": "主管审批",
      "assignee": "${manager}"
    },
    {
      "id": "Task_Hr",
      "type": "userTask",
      "name": "HR 审批",
      "assignee": "${hr}"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Apply"
    },
    {
      "id": "Flow_2",
      "from": "Task_Apply",
      "to": "Gateway_External"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Leader",
      "to": "Task_Hr",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Hr",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_9_R1",
      "from": "Task_Leader",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_9_R2",
      "from": "Task_Hr",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_External_Y",
      "from": "Gateway_External",
      "to": "Task_External",
      "name": "外部培训",
      "condition": "${external == true}"
    },
    {
      "id": "Flow_External_N",
      "from": "Gateway_External",
      "to": "Task_Leader",
      "name": "内部培训",
      "default": true
    },
    {
      "id": "Flow_External_M",
      "from": "Task_External",
      "to": "Task_Leader",
      "default": true
    },
    {
      "id": "Flow_External_R",
      "from": "Task_External",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
