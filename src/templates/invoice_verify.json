{
  "templateId": "invoice_verify",
  "name": "发票查验",
  "description": "报销凭证查验：财务查验票面后登记入账；是否查验异常时需税务专员复核",
  "keywords": [
    "发票",
    "查验",
    "票面",
    "查验抵扣"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "invoiceVerify",
  "processName": "发票查验",
  "variables": [
    {
      "name": "invoiceNo",
      "type": "string",
      "description": "发票号码"
    },
    {
      "name": "abnormal",
      "type": "boolean",
      "description": "发票查验是否异常（异常需税务专员复核）"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起发票查验"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交发票",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_Abnormal",
      "type": "exclusiveGateway",
      "name": "是否查验异常"
    },
    {
      "id": "Task_Abnormal",
      "type": "userTask",
      "name": "税务专员复核",
      "candidateGroups": "role_finance"
    },
    {
      "id": "Task_Check",
      "type": "userTask",
      "name": "财务查验",
      "candidateGroups": "role_finance"
    },
    {
      "id": "Task_Book",
      "type": "userTask",
      "name": "登记入账",
      "candidateGroups": "role_accountant"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_Abnormal"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Check",
      "to": "Task_Book",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Book",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_R1",
      "from": "Task_Check",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R2",
      "from": "Task_Book",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_Abnormal_Y",
      "from": "Gateway_Abnormal",
      "to": "Task_Abnormal",
      "name": "异常",
      "condition": "${abnormal == true}"
    },
    {
      "id": "Flow_Abnormal_N",
      "from": "Gateway_Abnormal",
      "to": "Task_Check",
      "name": "正常",
      "default": true
    },
    {
      "id": "Flow_Abnormal_M",
      "from": "Task_Abnormal",
      "to": "Task_Check",
      "default": true
    },
    {
      "id": "Flow_Abnormal_R",
      "from": "Task_Abnormal",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
