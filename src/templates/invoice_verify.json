{
  "templateId": "invoice_verify",
  "name": "发票查验",
  "description": "报销凭证查验：财务查验票面后登记入账",
  "keywords": [
    "发票",
    "查验",
    "票面",
    "查验抵扣"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "invoiceVerify",
  "processName": "发票查验",
  "variables": [
    {
      "name": "invoiceNo",
      "type": "string",
      "description": "发票号码"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起发票查验"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交发票",
      "assignee": "${initiator}"
    },
    {
      "id": "Task_Check",
      "type": "userTask",
      "name": "财务查验",
      "assignee": "${finance}"
    },
    {
      "id": "Task_Book",
      "type": "userTask",
      "name": "登记入账",
      "assignee": "${accountant}"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Task_Check"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Check",
      "to": "Task_Book",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Book",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_R1",
      "from": "Task_Check",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R2",
      "from": "Task_Book",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') == false}"
    }
  ]
}
