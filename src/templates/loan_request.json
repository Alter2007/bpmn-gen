{
  "templateId": "loan_request",
  "name": "借款申请",
  "description": "备用金借款：主管审批后由财务放款；是否超期未还时需财务总监审批",
  "keywords": [
    "借款",
    "备用金",
    "预支",
    "借支"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "loanRequest",
  "processName": "借款申请",
  "variables": [
    {
      "name": "amount",
      "type": "number",
      "description": "借款金额"
    },
    {
      "name": "overdue",
      "type": "boolean",
      "description": "借款人是否有超期未还借款（有则需财务总监审批）"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起借款申请"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "提交借款申请",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_Overdue",
      "type": "exclusiveGateway",
      "name": "是否超期未还"
    },
    {
      "id": "Task_Overdue",
      "type": "userTask",
      "name": "财务总监审批",
      "candidateGroups": "role_financeDirector"
    },
    {
      "id": "Task_Leader",
      "type": "userTask",
      "name": "主管审批",
      "candidateGroups": "role_manager"
    },
    {
      "id": "Task_Finance",
      "type": "userTask",
      "name": "财务放款",
      "candidateGroups": "role_finance"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_Overdue"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Leader",
      "to": "Task_Finance",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Finance",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_R1",
      "from": "Task_Leader",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R2",
      "from": "Task_Finance",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_Overdue_Y",
      "from": "Gateway_Overdue",
      "to": "Task_Overdue",
      "name": "有超期",
      "condition": "${overdue == true}"
    },
    {
      "id": "Flow_Overdue_N",
      "from": "Gateway_Overdue",
      "to": "Task_Leader",
      "name": "无超期",
      "default": true
    },
    {
      "id": "Flow_Overdue_M",
      "from": "Task_Overdue",
      "to": "Task_Leader",
      "default": true
    },
    {
      "id": "Flow_Overdue_R",
      "from": "Task_Overdue",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
