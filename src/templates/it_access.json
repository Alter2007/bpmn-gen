{
  "templateId": "it_access",
  "name": "IT 权限申请",
  "description": "系统权限：主管审批后由 IT 开通账号；是否生产环境时多走一道「运维总监审批」",
  "keywords": [
    "权限",
    "账号",
    "开通账号",
    "系统权限",
    "IT申请"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "itAccess",
  "processName": "IT 权限申请",
  "variables": [
    {
      "name": "system",
      "type": "string",
      "description": "目标系统"
    },
    {
      "name": "production",
      "type": "boolean",
      "description": "是否生产环境权限（生产需运维总监审批）"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "发起IT 权限申请"
    },
    {
      "id": "Task_Apply",
      "type": "userTask",
      "name": "提交权限申请",
      "assignee": "${initiator}"
    },
    {
      "id": "Task_Leader",
      "type": "userTask",
      "name": "主管审批",
      "candidateGroups": "role_manager"
    },
    {
      "id": "Gateway_Prod",
      "type": "exclusiveGateway",
      "name": "是否生产环境"
    },
    {
      "id": "Task_OpsDir",
      "type": "userTask",
      "name": "运维总监审批",
      "candidateGroups": "role_opsDirector"
    },
    {
      "id": "Task_It",
      "type": "userTask",
      "name": "IT 开通",
      "candidateGroups": "role_it"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Apply"
    },
    {
      "id": "Flow_2",
      "from": "Task_Apply",
      "to": "Task_Leader"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Leader",
      "to": "Gateway_Prod",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_It",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_9_R1",
      "from": "Task_Leader",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_9_R2",
      "from": "Task_It",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_Prod_Y",
      "from": "Gateway_Prod",
      "to": "Task_OpsDir",
      "name": "生产环境",
      "condition": "${production == true}"
    },
    {
      "id": "Flow_Prod_N",
      "from": "Gateway_Prod",
      "to": "Task_It",
      "name": "测试环境",
      "default": true
    },
    {
      "id": "Flow_Prod_M",
      "from": "Task_OpsDir",
      "to": "Task_It",
      "default": true
    },
    {
      "id": "Flow_Prod_R",
      "from": "Task_OpsDir",
      "to": "Task_Apply",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
