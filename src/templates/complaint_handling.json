{
  "templateId": "complaint_handling",
  "name": "投诉处理",
  "description": "政务信访/投诉：登记分办后由责任部门处理并回访；是否重大投诉时需主要领导审批",
  "keywords": [
    "投诉",
    "信访",
    "举报",
    "工单",
    "来信"
  ],
  "slotOrder": [],
  "slots": [],
  "processId": "complaintHandling",
  "processName": "投诉处理",
  "variables": [
    {
      "name": "caseNo",
      "type": "string",
      "description": "工单号"
    },
    {
      "name": "major",
      "type": "boolean",
      "description": "是否重大投诉（重大需主要领导审批）"
    }
  ],
  "nodes": [
    {
      "id": "StartEvent_1",
      "type": "startEvent",
      "name": "收到投诉"
    },
    {
      "id": "Task_Submit",
      "type": "userTask",
      "name": "登记投诉",
      "assignee": "${initiator}"
    },
    {
      "id": "Gateway_Major",
      "type": "exclusiveGateway",
      "name": "是否重大投诉"
    },
    {
      "id": "Task_Major",
      "type": "userTask",
      "name": "主要领导审批",
      "candidateGroups": "role_leader"
    },
    {
      "id": "Task_Assign",
      "type": "userTask",
      "name": "分办",
      "candidateGroups": "role_dispatcher"
    },
    {
      "id": "Task_Handle",
      "type": "userTask",
      "name": "责任部门处理",
      "candidateGroups": "role_handler"
    },
    {
      "id": "Task_Review",
      "type": "userTask",
      "name": "回访确认",
      "candidateGroups": "role_reviewer"
    },
    {
      "id": "EndEvent_1",
      "type": "endEvent",
      "name": "流程结束"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "from": "StartEvent_1",
      "to": "Task_Submit"
    },
    {
      "id": "Flow_2",
      "from": "Task_Submit",
      "to": "Gateway_Major"
    },
    {
      "id": "Flow_A1",
      "from": "Task_Assign",
      "to": "Task_Handle",
      "default": true
    },
    {
      "id": "Flow_A2",
      "from": "Task_Handle",
      "to": "Task_Review",
      "default": true
    },
    {
      "id": "Flow_End",
      "from": "Task_Review",
      "to": "EndEvent_1",
      "default": true
    },
    {
      "id": "Flow_R1",
      "from": "Task_Assign",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R2",
      "from": "Task_Handle",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_R3",
      "from": "Task_Review",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    },
    {
      "id": "Flow_Major_Y",
      "from": "Gateway_Major",
      "to": "Task_Major",
      "name": "重大",
      "condition": "${major == true}"
    },
    {
      "id": "Flow_Major_N",
      "from": "Gateway_Major",
      "to": "Task_Assign",
      "name": "一般",
      "default": true
    },
    {
      "id": "Flow_Major_M",
      "from": "Task_Major",
      "to": "Task_Assign",
      "default": true
    },
    {
      "id": "Flow_Major_R",
      "from": "Task_Major",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
