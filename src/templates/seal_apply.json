{
  "templateId": "seal_apply",
  "name": "用章申请",
  "description": "申请用章 → 审批 → 用印登记",
  "keywords": ["用章", "盖章", "公章", "印章", "用印", "登记", "合同章"],
  "slotOrder": [],
  "slots": [
    { "name": "subject", "type": "string", "default": "用章", "label": "业务对象" }
  ],
  "processId": "sealApply",
  "processName": "@subject@审批流程",
  "variables": [],
  "nodes": [
    { "id": "StartEvent_1", "type": "startEvent", "name": "发起@subject@申请" },
    { "id": "Task_Submit", "type": "userTask", "name": "填写用章申请", "assignee": "${initiator}" },
    { "id": "Task_Approve", "type": "userTask", "name": "行政审批", "assignee": "${admin}" },
    { "id": "Task_Register", "type": "userTask", "name": "用印登记", "assignee": "${sealKeeper}" },
    { "id": "EndEvent_1", "type": "endEvent", "name": "完成" }
  ],
  "flows": [
    { "id": "Flow_1", "from": "StartEvent_1", "to": "Task_Submit" },
    { "id": "Flow_2", "from": "Task_Submit", "to": "Task_Approve" },
    { "id": "Flow_3", "from": "Task_Approve", "to": "Task_Register" },
    { "id": "Flow_4", "from": "Task_Register", "to": "EndEvent_1" }
  ]
}
