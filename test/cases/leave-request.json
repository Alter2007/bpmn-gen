{
  "id": "leave-request",
  "name": "请假审批流",
  "processKey": "leaveRequest",
  "variables": [
    { "name": "days", "type": "number", "description": "请假天数" }
  ],
  "nodes": [
    { "id": "StartEvent_1", "type": "startEvent", "name": "提交申请" },
    { "id": "Task_Fill", "type": "userTask", "name": "填写请假单", "assignee": "${initiator}" },
    { "id": "Gateway_Days", "type": "exclusiveGateway", "name": "请假天数判断" },
    { "id": "Task_Leader", "type": "userTask", "name": "直属主管审批", "assignee": "${leader}" },
    { "id": "Task_HR", "type": "userTask", "name": "人事备案", "assignee": "${hr}" },
    { "id": "EndEvent_1", "type": "endEvent", "name": "结束" }
  ],
  "flows": [
    { "id": "Flow_1", "from": "StartEvent_1", "to": "Task_Fill" },
    { "id": "Flow_2", "from": "Task_Fill", "to": "Gateway_Days" },
    { "id": "Flow_3", "from": "Gateway_Days", "to": "Task_Leader", "name": "≤3天", "condition": "${days <= 3}" },
    { "id": "Flow_4", "from": "Gateway_Days", "to": "Task_HR", "name": "超过3天", "default": true },
    { "id": "Flow_5", "from": "Task_Leader", "to": "EndEvent_1" },
    { "id": "Flow_6", "from": "Task_HR", "to": "EndEvent_1" }
  ]
}
