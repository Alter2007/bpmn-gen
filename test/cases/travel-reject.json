{
  "id": "travel-reject",
  "name": "差旅报销（含驳回）",
  "processKey": "travelReject",
  "variables": [
    { "name": "amount", "type": "number", "description": "报销金额" },
    { "name": "approved", "type": "boolean", "description": "审批是否通过；false 时退回到提交节点" }
  ],
  "nodes": [
    { "id": "StartEvent_1", "type": "startEvent", "name": "发起报销" },
    { "id": "Task_Submit", "type": "userTask", "name": "提交报销单", "assignee": "${initiator}" },
    { "id": "Gateway_1", "type": "exclusiveGateway", "name": "报销金额判断" },
    { "id": "Task_Level1", "type": "userTask", "name": "主管审批", "assignee": "${manager}" },
    { "id": "Task_Level2", "type": "userTask", "name": "总监审批", "assignee": "${director}" },
    { "id": "Task_Finance", "type": "userTask", "name": "财务复核", "assignee": "${finance}" },
    { "id": "EndEvent_1", "type": "endEvent", "name": "审批完成" }
  ],
  "flows": [
    { "id": "Flow_1", "from": "StartEvent_1", "to": "Task_Submit" },
    { "id": "Flow_2", "from": "Task_Submit", "to": "Gateway_1" },
    { "id": "Flow_3", "from": "Gateway_1", "to": "Task_Level1", "name": "≤1000", "condition": "${amount <= 1000}" },
    { "id": "Flow_4", "from": "Gateway_1", "to": "Task_Level2", "name": "1000~5000", "condition": "${amount > 1000 && amount <= 5000}" },
    { "id": "Flow_5", "from": "Gateway_1", "to": "Task_Finance", "name": ">5000", "default": true },
    { "id": "Flow_6", "from": "Task_Level1", "to": "EndEvent_1", "default": true },
    { "id": "Flow_7", "from": "Task_Level2", "to": "EndEvent_1", "default": true },
    { "id": "Flow_8", "from": "Task_Finance", "to": "EndEvent_1", "default": true },
    { "id": "Flow_9", "from": "Task_Level1", "to": "Task_Submit", "name": "驳回", "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}" },
    { "id": "Flow_10", "from": "Task_Level2", "to": "Task_Submit", "name": "驳回", "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}" },
    { "id": "Flow_11", "from": "Task_Finance", "to": "Task_Submit", "name": "驳回", "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}" }
  ]
}
