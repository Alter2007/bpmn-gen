{
  "id": "timeout-escalation",
  "name": "审批超时升级",
  "processKey": "timeoutEscalation",
  "variables": [
    { "name": "approved", "type": "boolean", "description": "主管是否通过" }
  ],
  "nodes": [
    { "id": "StartEvent_1", "type": "startEvent", "name": "发起申请" },
    { "id": "Task_Submit", "type": "userTask", "name": "提交申请", "assignee": "${initiator}" },
    { "id": "Task_Approve", "type": "userTask", "name": "主管审批", "assignee": "${manager}", "default": true },
    {
      "id": "Boundary_Timeout",
      "type": "boundaryEvent",
      "name": "超时",
      "attachedTo": "Task_Approve",
      "cancelActivity": true,
      "timer": { "type": "duration", "value": "P3D" }
    },
    { "id": "Task_Escalate", "type": "userTask", "name": "上级审批", "assignee": "${director}" },
    { "id": "EndEvent_1", "type": "endEvent", "name": "流程结束" }
  ],
  "flows": [
    { "id": "Flow_1", "from": "StartEvent_1", "to": "Task_Submit" },
    { "id": "Flow_2", "from": "Task_Submit", "to": "Task_Approve" },
    { "id": "Flow_3", "from": "Task_Approve", "to": "EndEvent_1", "default": true },
    { "id": "Flow_4", "from": "Boundary_Timeout", "to": "Task_Escalate" },
    { "id": "Flow_5", "from": "Task_Escalate", "to": "EndEvent_1", "default": true },
    {
      "id": "Flow_6",
      "from": "Task_Approve",
      "to": "Task_Submit",
      "name": "驳回",
      "condition": "${execution.getVariable('approved') != null && execution.getVariable('approved') == false}"
    }
  ]
}
